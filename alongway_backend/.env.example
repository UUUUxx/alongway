AMAP_KEY=your_amap_web_service_api_key_here
# Both https://restapi.amap.com and https://restapi.amap.com/v3 are accepted.
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_TIMEOUT_SECONDS=20

# MVP Backend Configuration
# For SQLite (default MVP):
DATABASE_URL=sqlite:///./alongway_mvp.db

# Or use PostgreSQL (uncomment and fill):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/alongway_db

# Agent Service
AGENT_SERVICE_URL=http://localhost:8001
AGENT_SERVICE_TIMEOUT=180

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=False
