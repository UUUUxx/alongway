STEPFUN_API_KEY=your_stepfun_api_key_here
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-3.5-flash
STEPFUN_TIMEOUT_SECONDS=5
ALONGWAY_POI_TIMEOUT_SECONDS=20
ALONGWAY_ROUTE_TIMEOUT_SECONDS=120
ALONGWAY_BACKEND_BASE_URL=http://localhost:8000
ALONGWAY_REQUEST_TIMEOUT_SECONDS=60
ALONGWAY_USE_MOCK_BACKEND=false

# ── v2 optimization toggles ──
ROUTE_OPTIMIZATION_V2=true
HAVERSINE_TOPK=3
LLM_RULE_FIRST=true
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=300
CONNECTION_POOL_ENABLED=true
